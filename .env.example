# SwiftShip Backend Environment Variables
# Copy to .env and adjust

# JWT secret - CHANGE IN PRODUCTION
JWT_SECRET=swiftship-dev-secret-change-in-production
SECRET_KEY=swiftship-dev-secret-change-in-production

# Token lifetimes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_HOURS=1

# CORS - comma-separated or "*" for all
CORS_ORIGINS=*
# Example: CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app

# Database - SQLite default, or Postgres URL
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/swiftship

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:5173
